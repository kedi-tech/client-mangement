# Database connection string.
# SQLite (default, zero-config local development):
DATABASE_URL="file:./dev.db"
# Postgres (swap the provider in prisma/schema.prisma to "postgresql" first):
# DATABASE_URL="postgresql://user:password@localhost:5432/client_management"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Credentials created by `npm run db:seed` for the demo admin account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="password123"
