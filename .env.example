# Database connection string.
# SQLite (default, zero-config local development):
DATABASE_URL="file:./dev.db"
# Postgres (swap the provider in prisma/schema.prisma to "postgresql" first):
# DATABASE_URL="postgresql://user:password@localhost:5432/client_management"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Where uploaded files are written. Defaults to ./uploads next to the project.
# Files are never served statically — downloads go through /api/files/[id],
# which authorises the caller first.
# UPLOAD_DIR="/var/lib/client-management/uploads"

# Accounts created by `npm run db:seed`. The portal account is a client login
# scoped to one client; staff accounts see the admin app.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="password123"
SEED_PORTAL_EMAIL="client@example.com"
