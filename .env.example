# ---------------------------------------------------------------- required --

# Postgres. Two URLs, because Prisma Migrate must not go through a pooler.
#
# NEON — copy both from the Neon console (Connection Details):
#   DATABASE_URL          the *pooled* string (host contains "-pooler")
#   DATABASE_URL_UNPOOLED the *direct* string (same host without "-pooler")
# Keep sslmode=require on both.
#
# Do NOT add pgbouncer=true. Prisma's docs suggest it for transaction-mode
# poolers, but Neon's pooler supports prepared statements — and that flag makes
# Prisma disable them, which measured ~5x slower here (1084ms vs 218ms per
# query). connect_timeout covers Neon's scale-to-zero cold start.
#
# DATABASE_URL="postgresql://user:password@ep-name-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-name-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# SELF-HOSTED Postgres with no pooler — point both at the same server:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/client_management?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/client_management?schema=public"

# Secret used to sign session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
# Changing it signs everyone out, which is the fastest way to revoke all sessions.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ------------------------------------------------------- docker compose only --
# Read by docker-compose.yml, which builds DATABASE_URL from these and points the
# app at the `db` service. Ignored when running `npm run dev` against your own
# Postgres — that path uses DATABASE_URL above.

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-before-deploying"
POSTGRES_DB="client_management"

# Host port the app is published on, bound to 127.0.0.1.
APP_PORT="3000"

# Host port the database is published on, bound to 127.0.0.1. Only needed so
# `npm run dev` on the host can reach the containerised Postgres. Change it if a
# native PostgreSQL install already owns 5432 — then point DATABASE_URL at the
# same port.
DB_PORT="5432"

# ---------------------------------------------------------------- optional --

# Public origin of the deployment, e.g. https://clients.example.com
# APP_URL="https://clients.example.com"

# Where uploaded files are written. Defaults to ./uploads next to the project.
# In Docker this is a mounted volume — the container filesystem is disposable,
# so anything written outside the volume is lost on redeploy.
# Files are never served statically: downloads go through /api/files/[id],
# which authorises the caller first.
# UPLOAD_DIR="/var/lib/client-management/uploads"

# Opens /register to anyone. OFF by default — an open sign-up form would hand
# any visitor a staff account with access to every client record. The route
# stays available until the first admin exists, after which admins add
# teammates from /team. The boot-time environment check refuses to start with
# this set while NODE_ENV=production.
# ALLOW_OPEN_REGISTRATION="true"

# ------------------------------------------------------------ super admin --
# Read only by `npm run superadmin`, which creates or promotes the workspace
# owner. SUPER_ADMIN can manage admins and members; nobody can demote or delete
# it, so the workspace can never be locked out of account administration.
#
# Set these to real values in .env (which is gitignored) — never commit a
# password. On a re-run the password is left alone unless you also set
# SUPERADMIN_RESET_PASSWORD=true.

# SUPERADMIN_EMAIL="owner@example.com"
# SUPERADMIN_PASSWORD=""
# SUPERADMIN_NAME="Super Admin"
# SUPERADMIN_RESET_PASSWORD="false"

# --------------------------------------------------------- seed data only --
# Used by `npm run db:seed`, which creates a demo dataset. Never run the seed
# against a database holding real records: it clears every table first.

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="password123"
SEED_PORTAL_EMAIL="client@example.com"
