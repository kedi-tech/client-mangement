# Keep the build context small and, more importantly, keep secrets and local
# state out of the image.

.git
.gitignore
.github

node_modules
.next
out
build

# Never bake real configuration into an image.
.env
.env.*
!.env.example

# Local uploads and databases belong in volumes, not in the image.
uploads
*.db
*.db-journal
*.sqlite
prisma/dev.db*

Dockerfile
docker-compose.yml
.dockerignore
README.md

npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
.DS_Store
.vscode
.idea
