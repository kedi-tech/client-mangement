// Client Management — data model.
//
// Provider is Postgres (Neon in production). Schema changes are applied with
// versioned migrations (`prisma/migrations`), never `db push`: run
// `npm run db:migrate:dev` locally to author one, and the entrypoint runs
// `prisma migrate deploy` on boot. Money is integer cents so totals never drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection — what the running app uses for every query.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection, used only by Prisma Migrate.
  //
  // Neon's pooled endpoint is PgBouncer in transaction mode: it cannot hold the
  // session-level advisory lock migrations take, and it discards the prepared
  // statements DDL relies on. Running `migrate deploy` through the pooler hangs
  // or fails outright, so it gets its own direct URL. This is not a Prisma
  // <5.10 workaround — it is still required on Prisma 6.
  //
  // Self-hosting a single Postgres with no pooler? Point both at the same URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("MEMBER") // SUPER_ADMIN | ADMIN | MEMBER | CLIENT
  /// Set only for CLIENT accounts: the client whose portal this login can see.
  clientId     String?
  lastLoginAt  DateTime?
  /// Session tokens issued before this instant are rejected. Bumped whenever the
  /// password changes or an admin revokes access, so a stolen cookie stops
  /// working immediately instead of lasting until the JWT expires.
  sessionsValidFrom DateTime @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  portalClient Client?      @relation("PortalUser", fields: [clientId], references: [id], onDelete: Cascade)
  ownedClients Client[]     @relation("ClientOwner")
  tasks        Task[]       @relation("TaskAssignee")
  notes        Note[]
  activities   Activity[]
  attachments  Attachment[]

  @@index([clientId])
}

model Client {
  id          String   @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  website     String?
  industry    String?
  status      String   @default("LEAD") // LEAD | ACTIVE | INACTIVE | ARCHIVED
  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  country     String?
  notes       String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User?        @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  portalUsers User[]       @relation("PortalUser")
  contacts    Contact[]
  projects    Project[]
  invoices    Invoice[]
  tasks       Task[]
  noteLog     Note[]
  activities  Activity[]
  attachments Attachment[]

  @@index([status])
  @@index([ownerId])
  @@index([name])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([lastName])
}

model Project {
  id          String    @id @default(cuid())
  clientId    String
  name        String
  description String?
  status      String    @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  budgetCents Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  /// Where the delivered work lives — shown as a "Visit project" link in the portal.
  liveUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks       Task[]
  invoices    Invoice[]
  attachments Attachment[]

  @@index([clientId])
  @@index([status])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO") // TODO | IN_PROGRESS | DONE
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate     DateTime?
  completedAt DateTime?
  clientId    String?
  projectId   String?
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client   Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([clientId])
  @@index([projectId])
}

model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique
  clientId  String
  projectId String?
  status    String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | VOID
  issueDate DateTime  @default(now())
  dueDate   DateTime
  paidAt    DateTime?
  taxRate   Float     @default(0) // percent, e.g. 8.5
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   InvoiceItem[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Float  @default(1)
  unitPriceCents Int    @default(0)
  position       Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Note {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

/// A file exchanged with a client. Bytes live on disk under UPLOAD_DIR; only
/// metadata is stored here. Downloads are streamed through an authorised route
/// so files are never publicly reachable by URL.
model Attachment {
  id         String   @id @default(cuid())
  clientId   String
  projectId  String?
  /// Name as the uploader saw it, used for the download filename.
  filename   String
  /// Randomised name on disk; never derived from user input.
  storedName String   @unique
  mimeType   String
  sizeBytes  Int
  /// STAFF files are uploaded by your team; CLIENT files come from the portal.
  uploadedBy String   @default("STAFF") // STAFF | CLIENT
  uploaderId String?
  note       String?
  createdAt  DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([createdAt])
}

/// One failed sign-in attempt, used to throttle password guessing.
///
/// Rows are keyed by both the submitted email and the caller's IP so neither a
/// single account nor a spray across many accounts can be brute forced. Entries
/// older than the throttle window are pruned as they are read, so the table
/// stays small without a scheduled job.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// "email:someone@example.com" or "ip:203.0.113.7".
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// Append-only audit/activity feed rendered on the dashboard and client timeline.
model Activity {
  id         String   @id @default(cuid())
  type       String // CLIENT_CREATED | CLIENT_UPDATED | NOTE_ADDED | PROJECT_CREATED | ...
  message    String
  clientId   String?
  actorId    String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdAt])
}
